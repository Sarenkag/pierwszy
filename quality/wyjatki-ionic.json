    },
    {
      "co": [
        "css:.oest-pas",
        "klasa:oest-pas"
      ],
      "powod": "Tło pod paskiem stanu telefonu na starych ekranach (edge-to-edge bez twardej czarnej linii) do czasu ich przeniesienia na Ionic.",
      "zgoda": "cmsg_01XEAk2s9PJV8mCFfCy1yHHTSLrQHGxPZDFnqmWHzYCezq"
    },
    {
      "co": [
        "css:.oest-rowne ion-card",
        "css:.oest-rowne ion-card::part(native)",
        "klasa:oest-rowne"
      ],
      "powod": "Równa wysokość kafelków w grupie (zasada: przyciski w grupie równe).",
      "zgoda": "cmsg_01XEAk2s9PJV8mCFfCy1yHHTSLrQHGxPZDFnqmWHzYCezq"
    },
    {
      "co": [
        "css:.oest-inicjaly",
        "klasa:oest-inicjaly"
      ],
      "powod": "Kółko z inicjałami w ion-avatar, gdy profil nie ma zdjęcia.",

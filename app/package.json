{
  "name": "oest-app",
  "private": true,
  "version": "0.1.0",
  "description": "Aplikacja OEST na Androida (Capacitor). Strona w www/, inspekcje kopiowane z ../inspekcje.",
  "scripts": {
    "lang": "node scripts/check-lang.js",
    "copy-web": "npm run lang && node scripts/copy-web.js",
    "sync": "npm run copy-web && node scripts/wersja.js && cap sync android",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capgo/capacitor-social-login": "8.5.15",
    "@ionic/core": "9.0.13",
    "@ionic/vue": "9.0.13",
    "docxtemplater": "3.71.0",
    "jspdf": "4.2.1",
    "pdf-lib": "^1.17.1",
    "pizzip": "3.3.0",
    "vue": "3.5.46",
    "vue-router": "4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@vitejs/plugin-vue": "6.0.11",
    "vite": "8.3.8"
  }
}
